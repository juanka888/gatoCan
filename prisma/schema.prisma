generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  password           String?
  googleId           String?          @unique
  name               String?
  image              String?
  runnerBestScore    Int              @default(0)
  runnerBestDistance Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  profile            Profile?
  forumPosts         ForumPost[]
  forumComments      Comment[]
  donations          Donation[] // Relación con sus donaciones
  manualDonations    ManualDonation[]
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  email               String
  nombreCompleto      String?
  telefono            String?
  dniNie              String?
  direccion           String?
  codigoPostal        String?
  poblacion           String?
  karmaPoints         Int      @default(0)
  karmaRank           Int?
  totalDonaciones     Decimal  @default(0)
  runnerBestScore     Int      @default(0)
  runnerBestDistanceM Int      @default(0)
  aceptaPoliticas     Boolean  @default(false)
  runnerGlobalRank    Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([karmaPoints])
  @@index([runnerBestScore])
}

model ForumPost {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  category  String    @default("General")
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([category])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  postId    Int
  authorId  String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

// NUEVO MODELO PARA DONACIONES
model Donation {
  id         String  @id @default(cuid())
  amount     Decimal // Cantidad donada
  animalName String // El gato al que ayudó (Zeus, Nube, etc.)
  status     String  @default("succeeded") // Por si quieres trackear fallos

  // Relación Opcional: Si userId existe, es de usuario. Si no, es ANÓNIMA.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum ManualDonationStatus {
  PENDING
  APPROVED
}

model ManualDonation {
  id       String               @id @default(cuid())
  userId   String
  concepto String
  cantidad Decimal
  status   ManualDonationStatus @default(PENDING)
  fecha    DateTime             @default(now())
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([fecha])
}
