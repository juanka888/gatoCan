generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String?
  googleId           String?   @unique
  name               String?
  image              String?
  runnerBestScore    Int       @default(0)
  runnerBestDistance Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  profile            Profile?
  forumPosts         ForumPost[]
}

model Profile {
  id                  String   @id @default(cuid())
  userId               String   @unique
  email                String
  nombreCompleto       String?
  telefono             String?
  dniNie               String?
  direccion            String?
  codigoPostal         String?
  poblacion            String?
  karmaPoints          Int      @default(0)
  karmaRank            Int?
  totalDonaciones      Decimal  @default(0)
  runnerBestScore      Int      @default(0)
  runnerBestDistanceM  Int      @default(0)
  aceptaPoliticas      Boolean  @default(false)
  runnerGlobalRank     Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([karmaPoints])
  @@index([runnerBestScore])
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
